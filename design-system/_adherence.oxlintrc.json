{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/layout/**",
              "components/media/**",
              "ui_kits/balance-challenge/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|Inter))/i]",
        "message": "Font not provided by the design system. Available: Anton, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|value|total|caption|key|ref|className|style|children)$/]",
        "message": "<Countdown> doesn't accept that prop. Declared props: mode, value, total, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='Countdown'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:number|bar)$/]",
        "message": "<Countdown> mode must be one of 'number' | 'bar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|index|key|ref|className|style|children)$/]",
        "message": "<IconRow> doesn't accept that prop. Declared props: icon, title, index."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|score|logo|poseName|key|ref|className|style|children)$/]",
        "message": "<PhotoFrame> doesn't accept that prop. Declared props: photo, score, logo, poseName."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|variant|disabled|fullWidth|icon|key|ref|className|style|children)$/]",
        "message": "<PillButton> doesn't accept that prop. Declared props: label, onClick, variant, disabled, fullWidth, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost)$/]",
        "message": "<PillButton> variant must be one of 'primary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PoseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|difficulty|thumbnail|onClick|selected|key|ref|className|style|children)$/]",
        "message": "<PoseCard> doesn't accept that prop. Declared props: name, difficulty, thumbnail, onClick, selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='PoseCard'] > JSXAttribute[name.name='difficulty'] > Literal[value!=/^(?:Easy|Medium|Hard)$/]",
        "message": "<PoseCard> difficulty must be one of 'Easy' | 'Medium' | 'Hard'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|label|animate|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: value, size, label, animate."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Card": {
        "replaces": []
      },
      "Countdown": {
        "replaces": []
      },
      "IconRow": {
        "replaces": []
